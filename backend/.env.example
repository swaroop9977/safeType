# SafeType+ Environment Configuration
# Copy this to .env and configure as needed

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# API Key Authentication
# Set API_KEY_ENABLED=True and choose a strong random key for production.
# Leave API_KEY_ENABLED=False during local development to skip auth entirely.
API_KEY_ENABLED=False
API_KEY=replace-with-a-strong-random-key-in-production

# Model Configuration
NLP_MODEL=distilbert-base-uncased-finetuned-sst-2-english
SPACY_MODEL=en_core_web_sm

# OCR Configuration
TESSERACT_PATH=C:\Program Files\Tesseract-OCRtesseract.exe  

# Risk Thresholds
PII_WEIGHT=0.6
NLP_WEIGHT=0.4
LOW_RISK_THRESHOLD=0.3
HIGH_RISK_THRESHOLD=0.6

# Privacy Settings
ENABLE_LOGGING=False
STORE_DATA=False

# API Rate Limiting
# Maximum requests per minute per IP address.
# Production recommendation: 20-60 depending on expected traffic.
RATE_LIMIT=100

# CORS allowed origins (comma-separated)
# Dev default is the React dev server; change for production.
# Example production value: CORS_ORIGINS=https://yourapp.com
CORS_ORIGINS=http://localhost:3000

