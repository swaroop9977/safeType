# SafeType+ Environment Configuration
# Copy this to .env and configure as needed

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Model Configuration
NLP_MODEL=distilbert-base-uncased-finetuned-sst-2-english
SPACY_MODEL=en_core_web_sm

# OCR Configuration
TESSERACT_PATH=C:\Program Files\Tesseract-OCRtesseract.exe  

# Risk Thresholds
PII_WEIGHT=0.6
NLP_WEIGHT=0.4
LOW_RISK_THRESHOLD=0.3
HIGH_RISK_THRESHOLD=0.6

# Privacy Settings
ENABLE_LOGGING=False
STORE_DATA=False

# API Rate Limiting (requests per minute)
RATE_LIMIT=100

