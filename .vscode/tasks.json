{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run backend (Flask)",
			"type": "shell",
			"command": "python",
			"args": [
				"backend/app.py"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run frontend (React)",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"start"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}